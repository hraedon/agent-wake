# agent-wake-opencode environment variables
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# The shared secret is referenced from config.json via `secret_env`.
#
# Generate a secret with:
#   python ../../tools/generate-secret.py
#
# One env var per configured source. Names are arbitrary — they must
# match the `secret_env` entries in ~/.config/agent-wake/config.json.

AGENT_WAKE_DEMO_SECRET=replace-with-output-of-generate-secret

# Optional: override the config file location
# AGENT_WAKE_CONFIG=/absolute/path/to/config.json

# Example for additional sources:
# AGENT_WAKE_GITHUB_SECRET=...
# AGENT_WAKE_TELEGRAM_SECRET=...
