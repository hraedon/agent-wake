{
  "name": "agent-wake-opencode",
  "version": "0.1.0",
  "description": "opencode plugin for agent-wake — daemon-client edition",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm && tsc --emitDeclarationOnly",
    "test": "bun test --path-ignore-patterns='**/opencode.archived/**'"
  },
  "peerDependencies": {
    "opencode": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "opencode": {
      "optional": true
    }
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.10",
    "@types/node": "^22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.5"
  },
  "license": "MIT"
}
